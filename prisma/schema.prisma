generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id                    BigInt                  @id @default(autoincrement())
  full_name             String                  @db.VarChar(150)
  email                 String                  @unique(map: "email") @db.VarChar(150)
  phone                 String?                 @unique(map: "phone") @db.VarChar(20)
  password              String                  @db.VarChar(255)
  role                  users_role              @default(CUSTOMER)
  status                users_status            @default(ACTIVE)
  avatar                String?                 @db.VarChar(500)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  addresses             addresses[]
  ai_chat_sessions     ai_chat_sessions[]
  carts                 carts?
  coupon_usages         coupon_usages[]
  order_status_history order_status_history[]
  orders                orders[]
  reviews               reviews[]
  wishlists             wishlists[]
  password_reset_tokens password_reset_tokens[]
}

model password_reset_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model addresses {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt
  receiver_name String   @db.VarChar(150)
  phone         String   @db.VarChar(20)
  address       String   @db.VarChar(500)
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model categories {
  id         BigInt     @id @default(autoincrement())
  name       String     @db.VarChar(150)
  slug       String     @unique @db.VarChar(150)
  image      String?    @db.VarChar(500)
  sort_order Int        @default(0)
  status     Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  products   products[]
}

model brands {
  id         BigInt     @id @default(autoincrement())
  name       String     @db.VarChar(150)
  slug       String     @unique @db.VarChar(150)
  logo       String?    @db.VarChar(500)
  status     Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  products   products[]
}

model products {
  id                     BigInt                   @id @default(autoincrement())
  category_id            BigInt
  brand_id               BigInt?
  name                   String                   @db.VarChar(255)
  slug                   String                   @unique(map: "slug") @db.VarChar(255)
  short_description      String?                  @db.Text
  description            String?                  @db.Text
  thumbnail              String?                  @db.VarChar(500)
  status                 products_status          @default(ACTIVE)
  featured               Boolean                  @default(false)
  view_count             BigInt                   @default(0)
  sold_count             BigInt                   @default(0)
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  product_images         product_images[]
  product_specifications product_specifications[]
  product_variants       product_variants[]
  brands                 brands?                  @relation(fields: [brand_id], references: [id], onUpdate: NoAction)
  categories             categories               @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews                reviews[]
  wishlists              wishlists[]

  @@index([brand_id], map: "idx_products_brand")
  @@index([category_id], map: "idx_products_category")
  @@index([featured], map: "idx_products_featured")
  @@index([name], map: "idx_products_name")
  @@index([status], map: "idx_products_status")
}

model product_variants {
  id                       BigInt                     @id @default(autoincrement())
  product_id               BigInt
  sku                      String                     @unique(map: "sku") @db.VarChar(100)
  price                    Decimal                    @db.Decimal(15, 2)
  sale_price               Decimal?                   @db.Decimal(15, 2)
  stock_quantity           Int                        @default(0)
  image                    String?                    @db.VarChar(500)
  status                   Boolean                    @default(true)
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @updatedAt
  cart_items               cart_items[]
  order_items              order_items[]
  products                 products                   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant_attribute_values variant_attribute_values[]

  @@index([price], map: "idx_variants_price")
  @@index([product_id], map: "idx_variants_product")
}

model product_images {
  id         BigInt   @id @default(autoincrement())
  product_id BigInt
  image_url  String   @db.VarChar(500)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id])
}

model product_specifications {
  id         BigInt   @id @default(autoincrement())
  product_id BigInt
  spec_name  String   @db.VarChar(150)
  spec_value String   @db.Text
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id])
}

model attributes {
  id               BigInt             @id @default(autoincrement())
  name             String             @db.VarChar(100)
  attribute_values attribute_values[]
}

model attribute_values {
  id                       BigInt                     @id @default(autoincrement())
  attribute_id             BigInt
  value                    String                     @db.VarChar(100)
  attributes               attributes                 @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  variant_attribute_values variant_attribute_values[]

  @@index([attribute_id])
}

model variant_attribute_values {
  variant_id         BigInt
  attribute_value_id BigInt
  attribute_values   attribute_values @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants   product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([variant_id, attribute_value_id])
  @@index([attribute_value_id])
}

model carts {
  id         BigInt       @id @default(autoincrement())
  user_id    BigInt       @unique
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cart_items cart_items[]
}

model cart_items {
  id               BigInt           @id @default(autoincrement())
  cart_id          BigInt
  variant_id       BigInt
  quantity         Int              @default(1)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  carts            carts            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([cart_id])
  @@index([variant_id])
}

model coupons {
  id                  BigInt                @id @default(autoincrement())
  code                String                @unique @db.VarChar(50)
  discount_type       coupons_discount_type @default(FIXED)
  discount_value      Decimal               @db.Decimal(15, 2)
  min_order_amount    Decimal?              @db.Decimal(15, 2)
  max_discount_amount Decimal?              @db.Decimal(15, 2)
  usage_limit         Int?
  used_count          Int                   @default(0)
  start_date          DateTime?
  end_date            DateTime?
  status              Boolean               @default(true)
  created_at          DateTime              @default(now())
  coupon_usages       coupon_usages[]
  orders              orders[]
}

model coupon_usages {
  id        BigInt   @id @default(autoincrement())
  coupon_id BigInt
  user_id   BigInt
  order_id  BigInt
  used_at   DateTime @default(now())
  coupons   coupons  @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  orders    orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([coupon_id])
  @@index([user_id])
  @@index([order_id])
}

model orders {
  id                   BigInt                 @id @default(autoincrement())
  order_code           String                 @unique(map: "order_code") @db.VarChar(50)
  user_id              BigInt
  coupon_id            BigInt?
  receiver_name        String                 @db.VarChar(150)
  receiver_phone       String                 @db.VarChar(20)
  shipping_address     String                 @db.VarChar(500)
  subtotal             Decimal                @db.Decimal(15, 2)
  discount_amount      Decimal                @default(0.00) @db.Decimal(15, 2)
  shipping_fee         Decimal                @default(0.00) @db.Decimal(15, 2)
  total_amount         Decimal                @db.Decimal(15, 2)
  payment_method       payment_method         @default(COD)
  payment_status       payment_status         @default(UNPAID)
  status               orders_status          @default(PENDING)
  note                 String?                @db.Text
  cancelled_reason     String?                @db.Text
  confirmed_at         DateTime?
  shipping_at          DateTime?
  completed_at         DateTime?
  cancelled_at         DateTime?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  coupon_usages        coupon_usages[]
  order_items          order_items[]
  order_status_history order_status_history[]
  coupons              coupons?               @relation(fields: [coupon_id], references: [id], onUpdate: NoAction)
  users                users                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments             payments[]

  @@index([coupon_id], map: "fk_orders_coupon")
  @@index([created_at], map: "idx_orders_created")
  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user")
}

model order_items {
  id               BigInt           @id @default(autoincrement())
  order_id         BigInt
  variant_id       BigInt
  quantity         Int              @default(1)
  price            Decimal          @db.Decimal(15, 2)
  created_at       DateTime         @default(now())
  orders           orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews          reviews[]

  @@index([order_id])
  @@index([variant_id])
}

model order_status_history {
  id         BigInt   @id @default(autoincrement())
  order_id   BigInt
  old_status String?  @db.VarChar(50)
  new_status String   @db.VarChar(50)
  changed_by BigInt?
  note       String?  @db.Text
  created_at DateTime @default(now())
  users      users?   @relation(fields: [changed_by], references: [id], onUpdate: NoAction)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id])
  @@index([changed_by])
}

model payments {
  id               BigInt         @id @default(autoincrement())
  order_id         BigInt
  payment_method   payment_method
  transaction_code String?        @db.VarChar(255)
  amount           Decimal        @db.Decimal(15, 2)
  status           payment_status @default(PENDING)
  payment_response String?        @db.Text
  paid_at          DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  orders           orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id])
}

model reviews {
  id            BigInt          @id @default(autoincrement())
  user_id       BigInt
  product_id    BigInt
  order_item_id BigInt?
  rating        Int
  title         String?         @db.VarChar(255)
  comment       String?         @db.Text
  status        reviews_status  @default(APPROVED)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  review_images review_images[]
  order_items   order_items?    @relation(fields: [order_item_id], references: [id], onUpdate: NoAction)
  products      products        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_item_id])
  @@index([product_id], map: "idx_reviews_product")
  @@index([user_id], map: "idx_reviews_user")
}

model review_images {
  id         BigInt   @id @default(autoincrement())
  review_id  BigInt
  image_url  String   @db.VarChar(500)
  created_at DateTime @default(now())
  reviews    reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([review_id])
}

model wishlists {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  product_id BigInt
  created_at DateTime @default(now())
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id], map: "uk_wishlist")
  @@index([product_id])
}

model ai_chat_sessions {
  id               BigInt             @id @default(autoincrement())
  user_id          BigInt?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  ai_chat_messages ai_chat_messages[]
  users            users?             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model ai_chat_messages {
  id               BigInt                @id @default(autoincrement())
  session_id       BigInt
  role             ai_chat_messages_role @default(USER)
  content          String                @db.Text
  created_at       DateTime              @default(now())
  ai_chat_sessions ai_chat_sessions      @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
}

enum ai_chat_messages_role {
  USER
  ASSISTANT
  SYSTEM
}

enum payment_method {
  COD
  BANK_TRANSFER
  VNPAY
  MOMO
}

enum payment_status {
  UNPAID
  PENDING
  SUCCESS
  PAID
  FAILED
  REFUNDED
}

enum coupons_discount_type {
  PERCENT
  FIXED
}

enum users_role {
  CUSTOMER
  ADMIN
}

enum users_status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum reviews_status {
  PENDING
  APPROVED
  REJECTED
}

enum products_status {
  DRAFT
  ACTIVE
  INACTIVE
}

enum orders_status {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}